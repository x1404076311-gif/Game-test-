const fresh=()=>({
  version:1,phase:'intro',day:1,ap:3,energy:80,work:50,
  trust:{lin:45,chen:40,zhou:45},heat:0,flags:[],evidence:[],
  history:[],report:null,resume:null,ending:null
});
const clamp=n=>Math.max(0,Math.min(100,n));
const has=(s,id)=>s.flags.includes(id);
const chain=s=>
  (s.evidence.includes('raw')||s.evidence.includes('logs'))&&
  (s.evidence.includes('change')||s.evidence.includes('snapshot'))&&
  (s.evidence.includes('approval')||s.evidence.includes('minutes'))&&
  s.evidence.includes('fix');
const allies=s=>Object.values(s.trust).filter(n=>n>=60).length;

function apply(s,e={},ev=[]){
  for(const k of ['work','heat'])s[k]=clamp(s[k]+(e[k]||0));
  for(const k of ['lin','chen','zhou'])s.trust[k]=clamp(s.trust[k]+(e[k]||0));
  if(e.energy)s.energy=clamp(s.energy+e.energy);
  for(const f of e.flags||[])if(!has(s,f))s.flags.push(f);
  for(const f of ev)if(!s.evidence.includes(f))s.evidence.push(f);
}
function note(s,title,text,resume){
  s.history.push({day:s.day,title,text});
  s.report={title,text};s.resume=resume;s.phase='report';
}
function act(s,a){
  if(s.phase!=='explore'||s.ap<=0||s.energy<a.cost||
    (!a.repeat&&has(s,a.id))||(a.need&&!a.need(s)))return false;
  s.ap--;s.energy=clamp(s.energy-a.cost);apply(s,a.effect,a.ev);
  if(!a.repeat)s.flags.push(a.id);
  const next=s.day===1&&!has(s,'meeting1')?'meeting':
    s.ap===0?(s.day===1?'night':s.day===5?'decision':'meeting'):'explore';
  note(s,a.label,a.text,next);
  return true;
}
function meet(s,m){
  if(s.phase!=='meeting'||(m.need&&!m.need(s)))return false;
  apply(s,m.effect,m.ev);s.flags.push('meeting'+s.day);
  note(s,m.label,m.text,s.day===1&&s.ap>0?'explore':'night');
  return true;
}
function advance(s){
  if(s.phase==='intro'){s.phase='explore';return true}
  if(s.phase==='report'){s.phase=s.resume;s.resume=null;return true}
  if(s.phase==='night'&&s.day<5){
    s.day++;s.ap=3;s.energy=clamp(s.energy+15);s.phase='explore';return true
  }
  return false;
}
function finish(s,id){
  if(s.phase!=='decision')return false;
  if(id==='reform'&&!(chain(s)&&allies(s)>=2&&has(s,'plan')))return false;
  if(id==='leave'&&!chain(s))return false;
  if(id==='promote'&&!(has(s,'offer')&&has(s,'signed')&&s.work>=65))return false;
  s.ending=id==='stay'?
    (s.work>=60&&!has(s,'signed')?'stay':'failure'):id;
  s.phase='ending';
  s.history.push({day:5,title:'最终决定',text:s.ending});
  return true;
}

const allowedFlags=new Set(
  chapters.flatMap(c=>c.actions.map(a=>a.id)).concat(
    ['plan','signed','offer','boundary','meeting1','meeting2','meeting3','meeting4']
  )
);
const allowedEvidence=new Set(Object.keys(EVIDENCE));

function valid(s,af=allowedFlags,ae=allowedEvidence){
  const phases=['intro','explore','meeting','night','decision','report','ending'];
  const endings=['stay','reform','leave','promote','failure'];
  const num=(n,a,b)=>Number.isInteger(n)&&n>=a&&n<=b;
  const str=(t,n)=>typeof t==='string'&&t.length<=n;
  const list=(a,allowed)=>Array.isArray(a)&&a.length<=100&&
    new Set(a).size===a.length&&a.every(x=>typeof x==='string'&&allowed.has(x));
  if(!s||typeof s!=='object'||s.version!==1||!phases.includes(s.phase)||
    !num(s.day,1,5)||!num(s.ap,0,3)||!num(s.energy,0,100)||
    !num(s.work,0,100)||!num(s.heat,0,100))return false;
  if(!s.trust||!['lin','chen','zhou'].every(k=>num(s.trust[k],0,100)))return false;
  if(!list(s.flags,af)||!list(s.evidence,ae))return false;
  if(!Array.isArray(s.history)||s.history.length>100||
    !s.history.every(x=>x&&num(x.day,1,5)&&str(x.title,120)&&str(x.text,5000)))return false;
  if(s.phase==='report'){
    if(!s.report||!str(s.report.title,120)||!str(s.report.text,5000)||
      !['explore','meeting','night','decision'].includes(s.resume))return false;
  }else if(s.resume!==null)return false;
  if(s.phase==='ending'){
    if(!endings.includes(s.ending))return false;
  }else if(s.ending!==null)return false;
  const p=s.phase==='report'?s.resume:s.phase;
  if(p==='intro'&&(s.day!==1||s.ap!==3||s.flags.length||
    s.history.length||s.evidence.length))return false;
  if(p==='explore'&&s.ap<=0)return false;
  if(p==='meeting'&&(s.day===5||
    (s.day===1?(s.ap>2||has(s,'meeting1')):s.ap!==0)))return false;
  if(p==='night'&&(s.day===5||s.ap!==0||!has(s,'meeting'+s.day)))return false;
  if((p==='decision'||p==='ending')&&(s.day!==5||s.ap!==0))return false;
  for(let d=1;d<s.day;d++)if(!has(s,'meeting'+d))return false;
  return true;
}

