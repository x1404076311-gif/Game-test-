function save(){
  try{
    localStorage.setItem(SAVE_KEY,JSON.stringify(state));
    storageOK=true;
  }catch(e){
    storageOK=false;
    toast('自动存档不可用，请导出存档保留进度。');
  }
}
function commit(fn){
  if(fn()===false)return;
  save();render();
  if(window.matchMedia('(max-width:760px)').matches){
    document.querySelector('.paper').scrollIntoView({block:'start',behavior:'auto'});
  }
}
let keyActions=[];
function choice(box,label,hint,fn,disabled=false,primary=false){
  const i=keyActions.length;
  const b=node('button','choice'+(primary?' primary':''));
  b.type='button';b.disabled=disabled;
  const key=String.fromCharCode(65+i);
  b.append(node('span','key',key));
  const copy=node('span');
  copy.append(node('strong','',label));
  if(hint)copy.append(node('small','',hint));
  b.append(copy);
  b.addEventListener('click',fn);
  box.append(b);
  keyActions.push({key,button:b});
  return b;
}
function prose(parent,text){
  const box=node('div','prose');
  for(const p of text.split('\n\n')){
    box.append(node('p',p.startsWith('“')?'quote':'',p));
  }
  parent.append(box);
}
function title(text,kicker){
  if(kicker)$('stage').append(node('p','chapter',kicker));
  $('stage').append(node('h2','',text));
}
function choicesBox(){
  const b=node('div','choices');$('stage').append(b);return b;
}
function conditions(){
  return [
    [state.evidence.includes('raw')||state.evidence.includes('logs'),'问题存在'],
    [state.evidence.includes('change')||state.evidence.includes('snapshot'),'人为修改'],
    [state.evidence.includes('approval')||state.evidence.includes('minutes'),'批准记录'],
    [state.evidence.includes('fix'),'风险尚未解除']
  ];
}
function render(){
  keyActions=[];
  $('stage').replaceChildren();
  const c=chapters[state.day-1];
  $('day-label').textContent=DAYS[state.day-1]+' · '+c.title;
  $('objective').textContent=c.goal;
  $('energy-value').textContent=state.energy+' / 100';
  $('work-value').textContent=state.work+' / 100';
  $('energy-bar').style.width=state.energy+'%';
  $('work-bar').style.width=state.work+'%';
  $('timeline').replaceChildren();
  DAYS.forEach((d,i)=>{
    const dot=node('span','dot'+(i+1===state.day?' active':i+1<state.day?' done':''),d.slice(1));
    dot.setAttribute('aria-label',d+(i+1===state.day?'，当前日期':''));
    $('timeline').append(dot);
  });
  $('side-note').replaceChildren(
    node('b','',state.phase==='ending'?'本周已结束':'剩余自由行动：'+state.ap+' / 3'),
    node('div','', '已记录线索：'+state.evidence.length+' 项'),
    node('div','',state.heat>=35?'最近有人开始询问你在查哪些文件。':'每天夜间恢复 15 点精力。')
  );
  $('save-label').textContent=storageOK?'进度在本机保存':'请导出存档';
  $('scene-label').textContent=state.phase==='ending'?'本周结案档案':
    '灯塔项目 / 第 '+state.day+' 个工作日';

  if(state.phase==='intro'){
    title('欢迎入职。','序章 / 临时工牌');
    prose($('stage'),
      '你是衡川科技新入职的项目运营。\n\n你接手的“灯塔”系统将在周五验收。同一天，直属领导将完成你的首次试用期考核。\n\n前任许知远已经离职。他留下了一个抽屉、一份没有完成的交接文档，以及一些不太像正常交接的提醒。\n\n你的任务：把工作做好，弄清事实，然后决定自己的名字应该出现在哪份文件上。'
    );
    $('stage').append(node('div','requirement',
      '五个工作日 · 四条主要结局\n每天 3 次自由行动；调查、工作与休息需要取舍。\n没有随机判定。证据、工作表现与承诺共同影响结果。'));
    choice(choicesBox(),'领取工牌，开始周一','预计 20～30 分钟；自动存档。',()=>commit(()=>advance(state)),false,true);
    $('stage').append(node('p','note','电脑可按选项字母选择。打开笔记不会消耗行动。'));
  }

  if(state.phase==='explore'){
    const first=state.day===1&&!has(state,'meeting1');
    title(first?'三条消息，一次选择。':'现在，你要先做什么？',
      DAYS[state.day-1]+' / '+c.title);
    prose($('stage'),state.day===1&&has(state,'meeting1')?c.later:c.intro);
    const box=choicesBox();
    c.actions.forEach(a=>{
      const used=!a.repeat&&has(state,a.id);
      const unavailable=a.need&&!a.need(state);
      const tired=state.energy<a.cost;
      let hint=a.hint+' 消耗 1 次行动'+(a.cost?'、'+a.cost+' 点精力':'')+'。';
      if(used)hint='已完成这项行动。';
      else if(unavailable)hint='当前权限已收紧，可寻找其他正式记录。';
      else if(tired)hint='精力不足。可以先休息，或选择其他行动。';
      choice(box,a.label,hint,()=>commit(()=>act(state,a)),used||unavailable||tired);
    });
    $('stage').append(node('p','note',
      first?'第一次行动后，自动进入十点客户会。':
      '完成今天的自由行动后，进入关键事件。休息也会占用一次行动。'));
  }

  if(state.phase==='meeting'){
    const m=meetings[state.day-1];
    title(m.title,'必要事件 / 不消耗自由行动');
    prose($('stage'),m.text);
    const box=choicesBox();
    m.choices.forEach(a=>{
      const blocked=a.need&&!a.need(state);
      choice(box,a.label,blocked?'尚未取得支持这项回应的线索。':a.hint,
        ()=>commit(()=>meet(state,a)),blocked);
    });
  }

  if(state.phase==='report'){
    title(state.report.title,'选择已发生 / 后果记录');
    prose($('stage'),state.report.text);
    const lastAction=chapters[state.day-1].actions.find(a=>a.label===state.report.title)||
      meetings[state.day-1]?.choices.find(a=>a.label===state.report.title);
    if(lastAction?.ev.length){
      $('stage').append(node('div','evidence-alert',
        '笔记已更新：'+lastAction.ev.map(k=>EVIDENCE[k].title).join('、')+'。可在“证据笔记”中查阅。'));
    }
    const nextNames={
      explore:'继续今天的行动',meeting:'进入会议',
      night:'结束今天的工作',decision:'进入周五最终会议'
    };
    choice(choicesBox(),nextNames[state.resume],'这段记录已保存。',()=>commit(()=>advance(state)),false,true);
  }

  if(state.phase==='night'){
    title('今天，到这里。',DAYS[state.day-1]+' / 下班之后');
    const texts=[
      '你把临时工牌放在桌上。\n\n第一天没有教会你这家公司的全部规则。至少你已经知道，交接不是把文件拖进一个文件夹。',
      '客户的问题还没有真正解决。\n\n你看了一遍今天的记录。把问题说清楚，比把问题说小一点更费力。',
      has(state,'signed')?
        '签字后的确认单已经归档。\n\n你盯着自己的名字。以后有人问起这段历史，这份文件会替你先回答。':
        '你没有替未经核实的历史作保证。\n\n这让流程慢了一点，也让你的名字暂时留在了正确的位置。',
      '明天，考核和验收会同时发生。\n\n你把证据和待办整理好。职场里最难的选择，有时不是该说什么，而是愿意为哪句话承担后果。'
    ];
    prose($('stage'),texts[state.day-1]);
    $('stage').append(node('div','requirement',
      '工作表现：'+state.work+' / 100\n已记录线索：'+state.evidence.length+
      ' 项\n睡眠将恢复 15 点精力，明天重新获得 3 次自由行动。'));
    choice(choicesBox(),'进入'+DAYS[state.day],'带着今天的选择继续。',()=>commit(()=>advance(state)),false,true);
  }

  if(state.phase==='decision'){
    title('你的名字，签在哪里？','周五 / 15:00 / 最终会议');
    prose($('stage'),
      '会议室里坐着客户、周岚、林晓、陈默和贺维。\n\n桌上是试用期考核表与项目验收确认单。\n\n客户问：“所以，我们今天能确认什么？”\n\n这一次，所有人都等着你回答。'
    );
    const req=node('div','requirement');
    conditions().forEach(([ok,t])=>req.append(node('div','',(ok?'✓ ':'○ ')+t)));
    req.append(node('div','',(has(state,'plan')?'✓ ':'○ ')+'已有补救方案'));
    req.append(node('div','',(allies(state)>=2?'✓ ':'○ ')+'至少两人愿意正式支持'));
    $('stage').append(req);
    const box=choicesBox();
    const reformOK=chain(state)&&allies(state)>=2&&has(state,'plan');
    const promoteOK=has(state,'offer')&&has(state,'signed')&&state.work>=65;
    choice(box,'留下工作，确认自己能证明的部分',
      '工作表现达标且未作不实历史确认，可获得转正；否则进入失败尾声。',
      ()=>commit(()=>finish(state,'stay')));
    choice(box,'提交完整材料，与同事推动正式整改',
      reformOK?'证据、支持与方案已具备。':'需要完整证据链、补救方案和至少两名支持者。',
      ()=>commit(()=>finish(state,'reform')),!reformOK);
    choice(box,'交清事实，拒绝历史责任后离职',
      chain(state)?'完整证据链已具备。':'需要完整证据链。',
      ()=>commit(()=>finish(state,'leave')),!chain(state));
    choice(box,'接受新职位，按美化材料继续验收',
      promoteOK?'交易条件已具备。':'需要晋升提议、已签署的历史确认，且工作表现至少 65。',
      ()=>commit(()=>finish(state,'promote')),!promoteOK);
  }

  if(state.phase==='ending')renderEnding();
}

function renderEnding(){
  const ending=state.ending;
  const data={
    stay:{
      title:'工牌还在',
      text:'你通过了考核。\n\n最终材料明确了你本周核实的范围，历史问题被列入后续处理。你没有主动推动全面调查，也没有替未知的过去签字。\n\n周一早上，你再次刷开办公室的门。工牌不再是临时的。\n\n林晓抬头问：“新来的运营，坐你旁边？”\n\n你看了一眼那个抽屉，说：“我先给他做交接。”'
    },
    reform:{
      title:'会议纪要已更新',
      text:'你依次展示原始问题、口径修改、批准记录和未完成修复任务。\n\n同事没有替你喊口号，而是各自确认了自己能证明的事实。\n\n客户同意延期复测，要求重新回填数据。项目进入正式调查，临时统计方式和批准责任都被记录。\n\n'+(state.work>=60?
        '你的考核通过了。周岚在评价里写：“能将风险转化为可执行事项。”':
        '项目开始整改，但你的考核没有通过。改变发生了，代价也仍然存在。')+
      '\n\n散会后，陈默发来新版任务板：“这次真的有人负责。”'
    },
    leave:{
      title:'最后一次打卡',
      text:'你提交完整记录，拒绝承担不属于自己的历史责任，并交清尚未完成的工作。\n\n公司没有在那一刻突然变好。调查被登记，后续结果需要时间。\n\n你把工牌放在前台。'+(has(state,'signed')?
        '你同时提交了此前签字文件的更正说明；那次签字没有被你从历史里删掉。':
        '你的名字，没有落在那份历史保证上。')+
      '\n\n'+(allies(state)>=2?'林晓和陈默送你到电梯口。':'电梯门关上前，你看见有人从工位抬起头。')+
      '\n\n门开了。外面不是一个保证更好的世界，但你终于可以自己决定下一站。'
    },
    promote:{
      title:'你的新办公室',
      text:'职位调整邮件在周一上午发出。你成为了运营负责人。\n\n验收材料没有加入那批异常工单。历史确认附件上留着你的名字。\n\n两周后，新人问你：“这项口径，好像有点问题？”\n\n你看着日程表上即将开始的客户会，把一份确认单推了过去。\n\n“只是流程。”你听见自己说，“签完还要走其他审批。”\n\n新人低头，准备签字。'
    },
    failure:{
      title:has(state,'signed')?'名字留在了附件里':'试用期结束',
      text:has(state,'signed')?
        '你选择留下，但此前签署的历史确认成为了责任分配的依据。\n\n当客户要求解释异常时，那份附件被投到会议室屏幕上。你的名字清晰得没有办法忽略。\n\n工作做得再多，也不能自动取消已经作出的承诺。\n\n你需要在接下来的调查中解释自己的确认范围。这个星期，没有给你一个轻松的结尾。':
        '你没有签下不实的历史保证，但本周工作表现未达到考核要求。\n\n你收拾工位，交出临时工牌。尚未查清的问题，没有因为离职自动获得答案。\n\n走出大楼时，你记下了一件事：下一次，不只要知道该拒绝什么，也要准备好自己能完成什么。'
    }
  };
  const e=data[ending];
  $('stage').append(node('span','end-label',ending==='failure'?'路线失败尾声':'本周结局'));
  title(e.title,'结案 / 第五个工作日');
  prose($('stage'),e.text);
  $('stage').append(node('div','requirement',
    '本周记录\n工作表现：'+state.work+' / 100\n证据链：'+
    (chain(state)?'完整':'未完整')+'\n正式支持者：'+allies(state)+' 人\n历史确认：'+
    (has(state,'signed')?'已签署':'未签署不实历史保证')));
  const box=choicesBox();
  choice(box,'回看证据与行动记录','查看这一结局如何形成。',()=>openNotebook('history'));
  choice(box,'导出这一周的存档','保留这条路线。',exportSave);
  choice(box,'重新开始，尝试另一条路线','打开重新开始确认。',()=>$('confirm-dialog').showModal(),false,true);
}

let activeTab='evidence';
function openNotebook(tab='evidence'){
  activeTab=tab;renderNotebook();
  if(!$('notebook').open)$('notebook').showModal();
}
function entry(parent,title,text,small=''){
  const e=node('div','entry');
  e.append(node('strong','',title));
  if(small)e.append(node('small','',small));
  e.append(node('p','',text));parent.append(e);
}
function renderNotebook(){
  document.querySelectorAll('[data-tab]').forEach(b=>{
    b.classList.toggle('on',b.dataset.tab===activeTab);
    b.setAttribute('aria-pressed',b.dataset.tab===activeTab?'true':'false');
  });
  const box=$('notebook-content');box.replaceChildren();
  if(activeTab==='evidence'){
    entry(box,'证据链核对',
      conditions().map(([ok,t])=>(ok?'✓ ':'○ ')+t).join('\n')+
      '\n完整证据链需要四项全部核实。提醒和人物证词可以引导调查，不能独立证明全部责任。');
    if(!state.evidence.length)entry(box,'目前没有线索','从工作、对话和正式文件中寻找记录。');
    state.evidence.forEach(k=>{
      const e=EVIDENCE[k];entry(box,e.title,e.text,e.type);
    });
  }
  if(activeTab==='people'){
    const people=[
      ['lin','林晓 · 数据分析师','她希望有人准确解释口径，而不是把她的私人话语变成唯一责任证据。'],
      ['chen','陈默 · 资深工程师','他更愿意回应复现步骤、风险记录和可执行的修复工作。'],
      ['zhou','周岚 · 直属领导','她在意交付与团队处境；提出具体补救比只提出指控更容易获得配合。']
    ];
    people.forEach(([id,name,text])=>{
      const n=state.trust[id];
      const attitude=n>=60?'愿意在正式场合确认事实':
        n>=40?'仍在观察，愿意有限配合':'明显谨慎，尚不愿正式支持';
      entry(box,name,text,'当前反馈：'+attitude);
    });
    entry(box,'许知远 · 前任','他的提醒需要核实。他也有自己的责任与顾虑。');
    entry(box,'贺维 · 业务负责人','他希望验收按期完成。职位提议附带材料要求。');
    if(has(state,'signed'))entry(box,'需要记住的承诺','你已经签署历史确认。之后的工作表现不会自动抹去这项记录。');
    if(has(state,'plan'))entry(box,'已经准备的事项','你有一份可执行的修复与延期方案。');
  }
  if(activeTab==='history'){
    if(!state.history.length)entry(box,'一周尚未开始','第一项行动发生后，这里会记录你的选择。');
    [...state.history].reverse().forEach(h=>{
      const text=h.title==='最终决定'?'本周已作出最终决定。':h.text;
      entry(box,DAYS[h.day-1]+' · '+h.title,text);
    });
  }
  if(activeTab==='rules'){
    entry(box,'行动与精力','每天 3 次自由行动。工作、调查、对话和休息都会占用行动。会议不占用自由行动。休息恢复 25 点精力，每夜恢复 15 点。');
    entry(box,'选择与证据','没有随机判定。准备工作会开放会议选项，正式记录能补齐证据链。每项一次性调查只能完成一次，休息和日常工作可以重复。');
    entry(box,'人物关系','信任通过对话反馈体现。至少两名同事愿意正式支持，加上完整证据与补救方案，才能推动集体整改。');
    entry(box,'存档','每次选择后自动保存到当前浏览器。清理浏览器数据会移除存档。换浏览器或设备时，先导出，再导入 JSON 文件。');
    entry(box,'操作','点击选项，或在电脑上按 A、B、C 等字母。打开笔记不会消耗行动。重新开始前可以导出当前路线。');
  }
}

function exportSave(){
  const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url;a.download='周一请活下来-'+DAYS[state.day-1]+'-存档.json';
  document.body.append(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
  toast('存档已导出。');
}

$('open-notebook').addEventListener('click',()=>openNotebook());
$('close-notebook').addEventListener('click',()=>$('notebook').close());
document.querySelectorAll('[data-tab]').forEach(b=>{
  b.addEventListener('click',()=>{
    activeTab=b.dataset.tab;renderNotebook();
  });
});
$('export-save').addEventListener('click',exportSave);
$('import-save').addEventListener('click',()=>$('file-input').click());
$('file-input').addEventListener('change',async e=>{
  const file=e.target.files[0];
  if(!file)return;
  try{
    if(file.size>300000)throw Error('too large');
    const imported=JSON.parse(await file.text());
    if(!valid(imported))throw Error('invalid');
    state=imported;save();render();toast('存档已恢复。');
  }catch(err){
    toast('无法导入：文件格式、版本或游戏状态无效。当前进度已保留。');
  }finally{e.target.value=''}
});
$('restart').addEventListener('click',()=>$('confirm-dialog').showModal());
$('cancel-restart').addEventListener('click',()=>$('confirm-dialog').close());
$('confirm-restart').addEventListener('click',()=>{
  $('confirm-dialog').close();state=fresh();save();render();
  toast('新的一周开始了。');
});
document.addEventListener('keydown',e=>{
  if(e.ctrlKey||e.altKey||e.metaKey||e.repeat||
    $('notebook').open||$('confirm-dialog').open||
    ['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName))return;
  const action=keyActions.find(a=>a.key===e.key.toUpperCase());
  if(action&&!action.button.disabled){
    e.preventDefault();action.button.click();
  }
});
render();
if(loadMessage)toast(loadMessage);
</script>
